<main class="main-content">
    <div class="settings-page">
        <aside class="settings-page__sidebar">
            <!-- Используем готовую круглую кнопку-стрелку -->
            <a href="/settings" class="round-btn settings-page__back-btn router-link">&larr;</a>
        </aside>

        <main class="settings-page__content">
            <form action="/settings" method="GET" class="settings-profile">
                
                <div class="settings-profile__avatar-container">
                    <img src="{{settingsPage.user.avatar}}" alt="Аватар" class="settings-profile__avatar">
                </div>

                <div class="settings-profile__info-list">
                    <div class="settings-profile__info-item">
                        <label for="oldPassword" class="settings-profile__label">Старый пароль</label>
                        <input type="password" id="oldPassword" name="old_password" class="settings-profile__value" required>
                    </div>

                    <div class="settings-profile__info-item">
                        <label for="newPassword" class="settings-profile__label">Новый пароль</label>
                        <input type="password" id="newPassword" name="new_password" class="settings-profile__value" required>
                    </div>

                    <div class="settings-profile__info-item">
                        <label for="repeatPassword" class="settings-profile__label">Повторите новый пароль</label>
                        <input type="password" id="repeatPassword" name="repeat_password" class="settings-profile__value" required>
                    </div>
                </div>

                <!-- Единая кнопка сохранения в виде синего текста по ТЗ -->
                <div class="settings-profile__actions">
                    <button type="submit" class="form-button">Сохранить</button>
                </div>
                
            </form>
        </main>
    </div>
</main>
