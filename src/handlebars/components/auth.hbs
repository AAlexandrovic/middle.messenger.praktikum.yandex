<main class="main-content">
    <section class="auth-container">
        <h1 class="form-title">Вход</h1>
        <form id="auth-form" class="auth-container__form">
            <div class="form-field">
                <label for="login" class="form-field__label">Логин:</label>
                <input type="text" id="login" name="login" class="form-field__input" required>
            </div>

            <div class="form-field">
                <label for="password" class="form-field__label">Пароль:</label>
                <input type="password" id="password" name="password" class="form-field__input" required>
            </div>

            <button type="submit" class="form-button">Авторизоваться</button>
        </form>
        <p class="auth-container__text">
            <a href="/register" class="auth-container__link router-link">Нет аккаунта?</a>
        </p>
    </section>
</main>
